organization_id = "<frubble organization UUID, from Settings → Organization → General>"

# Human members who have already joined, keyed by a short handle (never an
# email: the handle appears in plan output). Level is member or admin; the
# owner, platform@frubble.ai, is not listed. CI reads this from the
# POSTHOG_MEMBERS secret instead.
members = {
  daniel = { email = "<email they joined with>", level = "admin" }
}
