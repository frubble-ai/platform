organization_id = "<frubble organization UUID, from Settings → Organization → General>"

# The owner account, never managed here; members may not name it.
owner_email = "<owner account email>"

# The organization's people (README, "Human access"); here only `posthog`, a
# level, matters, for people who have already joined. Keyed by a short handle,
# never an email. CI reads both values from the POSTHOG_OWNER_EMAIL and ACCESS
# secrets.
access = {
  daniel = { email = "<email they joined with>", posthog = "admin" }
}
