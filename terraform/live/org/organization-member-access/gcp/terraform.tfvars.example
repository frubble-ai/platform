# Applied by organization-member-access-cd from repository variables and the
# ORG_MEMBERS_ACCESS secret; this file is for a hand run only (README,
# "Human access").
org_id                = "<organization id>"
management_project_id = "<management project id>"
environment_projects  = { stg = "<stg project id>", prd = "<prd project id>" }
administrator         = "user:<administrator address>"
developer_group       = "group:<developer group address>"

org_members_access = <<-EOT
  {"alex": {"email": "alex@example.com", "gcp": {"stg": ["administration"], "prd": ["read_only"]}, "posthog": "member"}}
EOT
